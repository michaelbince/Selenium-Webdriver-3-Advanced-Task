{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "properties": {
    "type": { "type": "string" },
    "basketOrigin": { "type": "string" },
    "cartType": { "type": "string" },
    "code": { "type": "string" },
    "guid": { "type": "string" },
    "totalItems": { "type": "integer" },
    "totalPrice": {
      "type": "object",
      "properties": {
        "currencyIso": { "type": "string" },
        "value": { "type": "number" }
      },
      "required": ["currencyIso", "value"]
    }
  },
  "required": ["type", "cartType", "code", "guid", "totalItems", "totalPrice"]
}
